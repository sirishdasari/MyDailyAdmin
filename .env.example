APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_server_api_key

APPWRITE_DATABASE_ID=your_database_id

APPWRITE_TASKS_TABLE_ID=tasks
APPWRITE_PROJECTS_TABLE_ID=projects
APPWRITE_PROFILES_TABLE_ID=profiles
APPWRITE_TASK_COMMENTS_TABLE_ID=task_comments

# Optional local test:
# TEST_USER_ID=the_exact_Appwrite_Auth_Users_$id

# Optional Render security:
# MCP_ALLOWED_HOSTS=mydaily-mcp.onrender.com,mydaily-mcp.onrender.com:443
# MCP_ALLOWED_ORIGINS=https://your-app.example.com

# Shared/open guitar Appwrite tables. No API key is used by guitar tools.
APPWRITE_GUITAR_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_GUITAR_PROJECT_ID=your_guitar_project_id
APPWRITE_GUITAR_DATABASE_ID=your_guitar_database_id
APPWRITE_GUITAR_PRACTICE_TABLE_ID=guitarpractice
APPWRITE_GUITAR_PRACTICE_RECORDS_TABLE_ID=guitarPracticeRecords
